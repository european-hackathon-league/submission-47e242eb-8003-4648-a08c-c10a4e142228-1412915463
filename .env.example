# Copy to .env and fill in. Read only by the Node server (server.mjs); never exposed to the browser.

# Required for email drafting, stakeholder-response interpretation and web research.
# The app still runs without it; those features stay disabled.
OPENAI_API_KEY=

# Model for drafting and interpretation (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Model for cited web research (default: gpt-4.1-mini)
OPENAI_SEARCH_MODEL=gpt-4.1-mini

# Local port (default: 4173)
PORT=4173
